    "Choose saved clocks. Empty selection uses the shared list.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose saved clocks. Empty selection uses the shared list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择已保存的时钟。留空则使用共享列表。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ियाँ चुनें। खाली चयन साझा सूची का उपयोग करता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige relojes. La selección vacía usa la lista común."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الساعات. الاختيار الفارغ يستخدم القائمة المشتركة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les horloges. Une sélection vide utilise la liste commune."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘড়ি বেছে নিন। ফাঁকা থাকলে সাধারণ তালিকা ব্যবহার হবে।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha relógios. A seleção vazia usa a lista comum."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih jam. Pilihan kosong memakai daftar bersama."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گھڑیاں منتخب کریں۔ خالی انتخاب مشترک فہرست استعمال کرتا ہے۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите часы. Пустой выбор использует общий список."
          }
        }
      }
    },

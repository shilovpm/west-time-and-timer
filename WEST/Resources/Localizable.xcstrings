    "All IANA time zones are available. GMT and UTC offsets use current seasonal time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All IANA time zones are available. GMT and UTC offsets use current seasonal time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 IANA 时区均可用。GMT 和 UTC 偏移使用当前季节时间。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी IANA समय क्षेत्र उपलब्ध हैं। GMT और UTC अंतर वर्तमान मौसमी समय का उपयोग करते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Están disponibles todas las zonas horarias IANA. Los desfases GMT y UTC usan la hora estacional actual."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جميع مناطق IANA الزمنية متاحة. تستخدم إزاحات GMT وUTC الوقت الموسمي الحالي."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les fuseaux horaires IANA sont disponibles. Les décalages GMT et UTC utilisent l’heure saisonnière actuelle."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব IANA সময় অঞ্চল উপলভ্য। GMT এবং UTC পার্থক্য বর্তমান মৌসুমি সময় ব্যবহার করে।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os fusos horários IANA estão disponíveis. Os desvios GMT e UTC usam a hora sazonal atual."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua zona waktu IANA tersedia. Selisih GMT dan UTC memakai waktu musiman saat ini."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمام IANA ٹائم زون دستیاب ہیں۔ GMT اور UTC فرق موجودہ موسمی وقت استعمال کرتے ہیں۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступны все часовые пояса IANA. Смещения GMT и UTC учитывают текущее сезонное время."
          }
        }
      }
    },
    "Shared storage unavailable. Check signing and App Group configuration.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared storage unavailable. Check signing and App Group configuration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享存储不可用。请检查签名和 App Group 配置。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साझा स्टोरेज उपलब्ध नहीं है। साइनिंग और App Group कॉन्फ़िगरेशन जाँचें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento compartido no está disponible. Comprueba la firma y la configuración de App Group."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التخزين المشترك غير متاح. تحقّق من التوقيع وإعداد App Group."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage partagé est indisponible. Vérifiez la signature et la configuration de l’App Group."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেয়ার করা স্টোরেজ উপলভ্য নয়। সাইনিং এবং App Group কনফিগারেশন পরীক্ষা করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento partilhado não está disponível. Verifique a assinatura e a configuração do App Group."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan bersama tidak tersedia. Periksa penandatanganan dan konfigurasi App Group."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مشترکہ اسٹوریج دستیاب نہیں ہے۔ سائننگ اور App Group کنفیگریشن چیک کریں۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общее хранилище недоступно. Проверьте подпись и настройку App Group."
          }
        }
      }
    },
    "Saved data is invalid. The file has been preserved.": {

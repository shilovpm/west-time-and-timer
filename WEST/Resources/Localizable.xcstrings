    "Sleep counts toward the timer. Changing the system clock can change the remaining time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep counts toward the timer. Changing the system clock can change the remaining time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠时间计入计时。更改系统时间可能改变剩余时间。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नींद का समय गिना जाता है। सिस्टम घड़ी बदलने से शेष समय बदल सकता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reposo cuenta. Cambiar la hora del sistema puede cambiar el tiempo restante."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السكون محسوب. قد يؤدي تغيير ساعة النظام إلى تغيير الوقت المتبقي."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La veille compte. Modifier l’horloge système peut changer le temps restant."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘুমের সময় গণনা করা হয়। সিস্টেমের সময় বদলালে অবশিষ্ট সময় বদলাতে পারে।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A suspensão conta. Alterar o relógio do sistema pode alterar o tempo restante."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidur dihitung. Mengubah jam sistem dapat mengubah waktu tersisa."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیند کا وقت شمار ہوتا ہے۔ سسٹم گھڑی بدلنے سے باقی وقت بدل سکتا ہے۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон входит в отсчёт. Коррекция системных часов может изменить остаток."
          }
        }
      }
    },
